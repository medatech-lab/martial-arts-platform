generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Training {
  id        Int      @id @default(autoincrement())
  sport     String
  date      DateTime
  startTime String
  endTime   String
  trainer   String?
  location  String?
  capacity  Int
  bookable  Boolean  @default(true)
  createdAt DateTime @default(now())

  bookings Booking[]
}

model Booking {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String
  phone     String?
  createdAt DateTime @default(now())

  trainingId Int
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
}